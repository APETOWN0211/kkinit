# =====================================================================
# kkinit — Supabase (spec #6, #7)
# =====================================================================
#  - URL / ANON_KEY 는 클라이언트에 노출되는 public 값.
#  - service_role key 는 절대 여기에 두지 않는다 (spec #5 / #26).
#  - 값이 비어 있으면 `getStorageImageUrl()` 이 null 을 돌려주고
#    컴포넌트는 local placeholder (default-avatar.svg) 로 fallback 한다.
# =====================================================================

# Public URL of your Supabase project (https://<project>.supabase.co)
NUXT_PUBLIC_SUPABASE_URL=

# Public anon key from Supabase project settings → API
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Public storage bucket name (spec #7). Default: kkinit-images
NUXT_PUBLIC_SUPABASE_STORAGE_BUCKET=kkinit-images

# =====================================================================
# SERVER-ONLY (private, never exposed to the client).
# Used by the admin composable to bypass RLS for INSERT/UPDATE/DELETE on
# posts / post_images / post_tags / profiles.
# Find this in Supabase project settings → API → service_role.
# DO NOT prefix with NUXT_PUBLIC_ — that would leak it to the browser.
# =====================================================================
NUXT_SUPABASE_SERVICE_ROLE_KEY=
